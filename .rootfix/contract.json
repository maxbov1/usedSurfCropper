{
  "invocation": {
    "request_sha256": "9999991ca0962d83113a5bc41b956a982d222dd42bd76449c8d2c911a28d0898"
  },
  "laws": {
    "general": [
      {
        "id": "grouping.truthful",
        "statement": "Code generated should not silently assign a photo to a board when the available evidence is below the grouping threshold."
      }
    ],
    "feature": [
      {
        "id": "grouping.card-count-is-review-signal",
        "statement": "Code generated should not merge or split visual clusters solely to make their count equal the inventory-card count."
      },
      {
        "id": "grouping.visual-membership",
        "statement": "Code generated should not allow a card match to override a strong visual boundary between contiguous board-photo runs."
      },
      {
        "id": "grouping.explicit-evidence",
        "statement": "Code generated should not assign a photo with explicit identity evidence to a card whose corresponding value contradicts that evidence."
      },
      {
        "id": "grouping.angle-aware-evidence",
        "statement": "Code generated should not infer an identity field from an angle that cannot reliably expose that field."
      }
    ]
  },
  "negative_tests": [
    {
      "name": "incompatible runs stay separate when card count is lower",
      "law_id": "grouping.card-count-is-review-signal",
      "production": "organizer/ingest.py",
      "command": ["python3", "-m", "unittest", "tests.test_grouping.GroupingTests.test_visual_runs_are_not_forced_to_card_count"],
      "timeout_seconds": 60
    },
    {
      "name": "weak card match remains unassigned",
      "law_id": "grouping.truthful",
      "production": "organizer/ingest.py",
      "command": ["python3", "-m", "unittest", "tests.test_grouping.GroupingTests.test_weak_card_match_is_not_forced"],
      "timeout_seconds": 60
    },
    {
      "name": "explicit identity contradiction is not assigned",
      "law_id": "grouping.explicit-evidence",
      "production": "organizer/ingest.py",
      "command": ["python3", "-m", "unittest", "tests.test_grouping.GroupingTests.test_explicit_photo_identity_cannot_be_assigned_to_contradictory_card"],
      "timeout_seconds": 60
    },
    {
      "name": "identity evidence follows shot angle",
      "law_id": "grouping.angle-aware-evidence",
      "production": "organizer/board_evidence.py",
      "command": ["python3", "-m", "unittest", "tests.test_board_evidence.BoardEvidenceTests.test_evidence_is_angle_specific_and_optional"],
      "timeout_seconds": 60
    }
  ]
}
